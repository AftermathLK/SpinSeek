# Copy to .env next to docker-compose.yml and adjust.

# Unraid defaults: nobody:users
PUID=99
PGID=100
UMASK=022
TZ=Etc/UTC

# Web UI + API port (single port for everything)
PORT=3080

# Host path for /config (SQLite database lives here)
CONFIG_PATH=/mnt/user/appdata/spinseek

# Optional fixed login. Leave empty to create the login in the browser on first start;
# nothing is accessible until a login exists. Sessions last 30 days.
AUTH_USERNAME=
AUTH_PASSWORD=

# Optional: encryption key for stored API keys. If empty, Spin Seek generates /config/.secret_key.
# Setting it here keeps the key out of /config backups. Set it BEFORE first start
# (changing it later means re-entering your API keys).
APP_SECRET=

# Optional: only if Spin Seek sits behind a reverse proxy, its IP (e.g. 172.17.0.1), so the login
# rate limiter sees real client IPs. Leave empty otherwise: forwarded headers are then ignored.
TRUST_PROXY=
